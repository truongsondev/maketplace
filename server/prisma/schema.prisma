generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Standard JS Prisma Client runtime (required for running standalone Node scripts in containers)
generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PACKING
  AWAITING_PICKUP
  SHIPPED
  DELIVERING
  DELIVERY_FAILED
  LOST
  RETURN_TO_STORE
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PhysicalSaleStatus {
  COMPLETED
  CANCELLED
}

enum VoucherScopeType {
  ALL_PRODUCTS
  INCLUDE_CATEGORIES
  INCLUDE_PRODUCTS
  MEMBER_TIERS
}

enum VoucherMinAmountBasis {
  ELIGIBLE_SUBTOTAL
  CART_SUBTOTAL
}

enum PaymentStatus {
  PENDING
  /// New (spec): payment succeeded
  PAID
  /// Legacy (kept for backward compatibility; treat as PAID in code)
  SUCCESS
  FAILED
  /// New (spec): payment link expired
  EXPIRED
  REFUNDED
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
  /// New (spec): payment link expired
  EXPIRED
}

enum InventoryAction {
  IMPORT
  EXPORT
  RETURN
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

enum ReturnStatus {
  RT_REQUESTED
  RT_APPROVED
  RT_SHIPPING
  RT_COMPLETED
  RT_REJECTED
}

enum SalesChannel {
  ONLINE
  PHYSICAL_STORE
  INTERNAL
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  REVERSE
  ADJUST
  EXPIRE
}

enum ReturnFlowStatus {
  /// Buyer yeu cau tra hang (cho duyet)
  REQUESTED
  /// Admin da duyet yeu cau tra hang
  APPROVED
  /// GHN dang den lay hang tai dia chi khach
  PICKING
  /// Hang dang duoc gui tra ve shop
  SHIPPING
  /// Shop da nhan hang tra (ket thuc)
  COMPLETED
  /// Yeu cau tra hang bi tu choi (ket thuc)
  REJECTED
}

enum ReturnRequestType {
  EXCHANGE
  RETURN_REFUND
}

enum RefundType {
  CANCEL_REFUND
  RETURN_REFUND
  LOST_SHIPMENT_REFUND
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum CancelReason {
  NO_LONGER_NEEDED
  BUY_OTHER_ITEM
  FOUND_CHEAPER
  OTHER
}

enum CancelRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE // Giảm theo %
  FIXED_AMOUNT // Giảm số tiền cố định
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  SALE_PRICE
  COMBO_FIXED
  BUY_X_GET_Y
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum PromotionCampaignType {
  FLASH_SALE
  HOLIDAY
  CUSTOMER_APPRECIATION
  SEASONAL
  CUSTOM
}

enum PromotionScopeType {
  ALL_PRODUCTS
  INCLUDE_CATEGORIES
  INCLUDE_PRODUCTS
  MEMBER_TIERS
}

// ============================================================================
// LONG-TERM CATALOG (ProductType + Attribute System)
// (Additive: designed to coexist with current Product/ProductVariant JSON attrs)
// ============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum AttributeScope {
  PRODUCT
  VARIANT
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
}

enum RecommendationEventType {
  VIEW_PRODUCT
  ADD_TO_CART
  REMOVE_FROM_CART
  PURCHASE
  SEARCH_QUERY
  FAVORITE_PRODUCT
  RECOMMENDATION_IMPRESSION
  RECOMMENDATION_CLICK
}

enum RecommendationModelKind {
  TRENDING
  TOP_VIEWED
  TOP_PURCHASED
  ITEM_SIMILARITY
  PERSONALIZED
  HYBRID
  SESSION_BASED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatSessionStatus {
  OPEN
  QUALIFIED
  CONTACT_CAPTURED
  ESCALATED
  CLOSED
}

enum VirtualTryOnStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  TIMEOUT
}

// ============================================================================
// AUTHENTICATION
// ============================================================================

/// Bảng người dùng gốc - lưu thông tin xác thực cốt lõi
model User {
  id                   String     @id @default(uuid()) @db.VarChar(36)
  email                String?    @unique @db.VarChar(255)
  phone                String?    @unique @db.VarChar(20)
  passwordHash         String?    @map("password_hash") @db.VarChar(255)
  emailVerified        Boolean    @default(false) @map("email_verified")
  status               UserStatus @default(ACTIVE)
  lastLogin            DateTime?  @map("last_login")
  age                  Int?
  birthday             DateTime?  @db.Date
  heightCm             Decimal?   @map("height_cm") @db.Decimal(5, 2)
  weightKg             Decimal?   @map("weight_kg") @db.Decimal(5, 2)
  bodyProfileUpdatedAt DateTime?  @map("body_profile_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  addresses               UserAddress[]
  refreshTokens           RefreshToken[]
  oauthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userRoles               UserRole[]
  cart                    Cart?
  orders                  Order[]
  notifications           Notification[]
  activityLogs            UserActivityLog[]
  wishlist                Wishlist[]
  reviews                 Review[]
  recommendationEvents    RecommendationEvent[]
  recommendationCaches    RecommendationCache[]
  userEmbeddings          UserEmbedding[]
  chatSessions            ChatSession[]
  virtualTryOnRequests    VirtualTryOnRequest[]
  loyaltyAccount          LoyaltyAccount?
  birthdayVoucherGrants   BirthdayVoucherGrant[]

  @@map("users")
}

/// Quản lý phiên đăng nhập với JWT
model RefreshToken {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  token      String   @unique @db.VarChar(500)
  deviceInfo String?  @map("device_info") @db.VarChar(500)
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Email verification tokens for registration flow
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Password reset tokens for forgot-password flow
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Liên kết đăng nhập OAuth (Google, Facebook, Apple)
model OAuthAccount {
  id             String        @id @default(uuid()) @db.VarChar(36)
  userId         String        @map("user_id") @db.VarChar(36)
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ============================================================================
// AUTHORIZATION (RBAC)
// ============================================================================

/// Định nghĩa các vai trò trong hệ thống
model Role {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(50) // BUYER, SELLER, ADMIN
  name String @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

/// Bảng trung gian - gán vai trò cho user (n-n)
model UserRole {
  userId String @map("user_id") @db.VarChar(36)
  roleId Int    @map("role_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// PROFILE
// ============================================================================

/// Địa chỉ người dùng - quản lý nhiều địa chỉ giao hàng
model UserAddress {
  id            String  @id @default(uuid()) @db.VarChar(36)
  userId        String  @map("user_id") @db.VarChar(36)
  recipient     String  @db.VarChar(255)
  phone         String  @db.VarChar(20)
  addressLine   String  @map("address_line") @db.Text
  ward          String  @db.VarChar(100)
  district      String  @db.VarChar(100)
  city          String  @db.VarChar(100)
  isDefault     Boolean @default(false) @map("is_default")
  ghnProvinceId Int?    @map("ghn_province_id")
  ghnDistrictId Int?    @map("ghn_district_id")
  ghnWardCode   String? @map("ghn_ward_code") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

// ============================================================================
// PRODUCTS (Soft delete + variants + images + categories)
// ============================================================================

/// Sản phẩm - thông tin cơ bản; tồn kho & giá thực tế nằm ở ProductVariant
model Product {
  id            String        @id @default(uuid()) @db.VarChar(36)
  /// Loại sản phẩm (áo/quần/phụ kiện...). Nullable để migrate dần.
  productTypeId String?       @map("product_type_id") @db.VarChar(36)
  name          String        @db.VarChar(255)
  description   String?       @db.Text
  /// Giá hiển thị / khởi điểm; giá bán thực tế lấy từ ProductVariant.price
  basePrice     Decimal       @map("base_price") @db.Decimal(10, 2)
  /// Trạng thái catalog (đi đường dài). Migrate dần, mặc định ACTIVE.
  status        ProductStatus @default(ACTIVE)
  isSale        Boolean       @default(false) @map("is_sale")
  isDeleted     Boolean       @default(false) @map("is_deleted")
  /// Soft-delete chuẩn (nullable để migrate dần).
  deletedAt     DateTime?     @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  productType          ProductType?               @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  images               ProductImage[]
  categories           ProductCategory[]
  tags                 ProductTag[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  wishlist             Wishlist[]
  reviews              Review[]
  priceHistory         ProductPriceHistory[]
  recommendationEvents RecommendationEvent[]
  similaritySources    ProductSimilarity[]        @relation("ProductSimilaritySource")
  similarityTargets    ProductSimilarity[]        @relation("ProductSimilarityTarget")
  recommendationCaches RecommendationCache[]
  productEmbeddings    ProductEmbedding[]
  virtualTryOnRequests VirtualTryOnRequest[]
  sizeChartRules       SizeChartRule[]
  discountIncludes     DiscountIncludedProduct[]
  discountExcludes     DiscountExcludedProduct[]
  promotionIncludes    PromotionIncludedProduct[]

  attributeValues ProductAttributeValue[]

  @@index([createdAt])
  @@index([productTypeId, status])
  @@index([deletedAt])
  @@fulltext([name])
  @@map("products")
}

// ============================================================================
// PRODUCT VARIANTS & IMAGES
// ============================================================================

/// Biến thể sản phẩm - quản lý SKU, size/màu, tồn kho
model ProductVariant {
  id             String        @id @default(uuid()) @db.VarChar(36)
  productId      String        @map("product_id") @db.VarChar(36)
  sku            String        @unique @db.VarChar(100)
  /// Canonical key cho tổ hợp biến thể (vd: color=red|size=m). Nullable để backfill dần.
  optionKey      String?       @map("option_key") @db.VarChar(500)
  status         VariantStatus @default(ACTIVE)
  isDefault      Boolean       @default(false) @map("is_default")
  /// Thuộc tính biến thể: {"color": "đỏ", "size": "M"}
  attributes     Json          @default("{}")
  price          Decimal       @db.Decimal(10, 2)
  stockAvailable Int           @default(0) @map("stock_available")
  /// Chuẩn dài hạn: stockOnHand (giữ song song để migrate)
  stockOnHand    Int           @default(0) @map("stock_on_hand")
  stockReserved  Int           @default(0) @map("stock_reserved")
  minStock       Int           @default(5) @map("min_stock")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  deletedAt      DateTime?     @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  images            ProductImage[]
  inventoryLogs     InventoryLog[]
  priceHistory      ProductPriceHistory[]
  physicalSaleItems PhysicalSaleItem[]

  attributeValues VariantAttributeValue[]

  @@unique([productId, optionKey])
  @@index([productId])
  @@index([productId, status])
  @@index([deletedAt])
  @@map("product_variants")
}

/// Ảnh sản phẩm - ảnh chung hoặc riêng cho từng variant
model ProductImage {
  id        String  @id @default(uuid()) @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  variantId String? @map("variant_id") @db.VarChar(36)
  url       String  @db.VarChar(1000)
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_images")
}

// ============================================================================
// CATEGORIES & TAGS
// ============================================================================

model Category {
  id          String  @id @default(uuid()) @db.VarChar(36)
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.VarChar(1000)
  sortOrder   Int     @default(0) @map("sort_order")

  parentId String? @map("parent_id") @db.VarChar(36)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  parent            Category?                   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]                  @relation("CategoryHierarchy")
  products          ProductCategory[]
  discountIncludes  DiscountIncludedCategory[]
  discountExcludes  DiscountExcludedCategory[]
  promotionIncludes PromotionIncludedCategory[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

/// Bảng trung gian - sản phẩm thuộc nhiều danh mục
model ProductCategory {
  productId  String @map("product_id") @db.VarChar(36)
  categoryId String @map("category_id") @db.VarChar(36)

  /// Merchandising
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, isPrimary, sortOrder])
  @@map("product_categories")
}

// ============================================================================
// PRODUCT TYPE
// ============================================================================

model ProductType {
  id          String    @id @default(uuid()) @db.VarChar(36)
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products       Product[]
  attributes     ProductTypeAttribute[]
  sizeChartRules SizeChartRule[]

  @@index([deletedAt])
  @@map("product_types")
}

model SizeChartRule {
  id            String   @id @default(uuid()) @db.VarChar(36)
  productId     String?  @map("product_id") @db.VarChar(36)
  productTypeId String?  @map("product_type_id") @db.VarChar(36)
  sizeLabel     String   @map("size_label") @db.VarChar(30)
  minHeightCm   Decimal? @map("min_height_cm") @db.Decimal(5, 2)
  maxHeightCm   Decimal? @map("max_height_cm") @db.Decimal(5, 2)
  minWeightKg   Decimal? @map("min_weight_kg") @db.Decimal(5, 2)
  maxWeightKg   Decimal? @map("max_weight_kg") @db.Decimal(5, 2)
  fitPreference String   @default("REGULAR") @map("fit_preference") @db.VarChar(20)
  priority      Int      @default(0)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productType ProductType? @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@index([productTypeId, isActive])
  @@map("size_chart_rules")
}

// ============================================================================
// ATTRIBUTE DEFINITIONS
// ============================================================================

model AttributeDefinition {
  id       String            @id @default(uuid()) @db.VarChar(36)
  code     String            @unique @db.VarChar(100)
  name     String            @db.VarChar(255)
  scope    AttributeScope
  dataType AttributeDataType @map("data_type")
  unit     String?           @db.VarChar(50)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  options       AttributeOption[]
  typeMaps      ProductTypeAttribute[]
  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@index([scope, dataType])
  @@index([deletedAt])
  @@map("attribute_definitions")
}

model AttributeOption {
  id          String  @id @default(uuid()) @db.VarChar(36)
  attributeId String  @map("attribute_id") @db.VarChar(36)
  value       String  @db.VarChar(100)
  label       String  @db.VarChar(255)
  sortOrder   Int     @default(0) @map("sort_order")
  swatchHex   String? @map("swatch_hex") @db.VarChar(16)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  productValues           ProductAttributeValue[]
  productMultiSelectJoins ProductAttributeValueOption[]
  variantValues           VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
  @@index([deletedAt])
  @@map("attribute_options")
}

model ProductTypeAttribute {
  productTypeId String @map("product_type_id") @db.VarChar(36)
  attributeId   String @map("attribute_id") @db.VarChar(36)

  isRequired       Boolean @default(false) @map("is_required")
  isFilterable     Boolean @default(false) @map("is_filterable")
  isVariantAxis    Boolean @default(false) @map("is_variant_axis")
  variantAxisOrder Int?    @map("variant_axis_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productType ProductType         @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productTypeId, attributeId])
  @@index([productTypeId, isVariantAxis, variantAxisOrder])
  @@map("product_type_attributes")
}

// ============================================================================
// ATTRIBUTE VALUES (PRODUCT)
// ============================================================================

model ProductAttributeValue {
  id          String @id @default(uuid()) @db.VarChar(36)
  productId   String @map("product_id") @db.VarChar(36)
  attributeId String @map("attribute_id") @db.VarChar(36)

  textValue    String?   @map("text_value") @db.Text
  numberValue  Decimal?  @map("number_value") @db.Decimal(18, 4)
  booleanValue Boolean?  @map("boolean_value")
  dateValue    DateTime? @map("date_value")
  optionId     String?   @map("option_id") @db.VarChar(36)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  multiSelectOptions ProductAttributeValueOption[]

  @@unique([productId, attributeId])
  @@index([attributeId, optionId])
  @@index([deletedAt])
  @@map("product_attribute_values")
}

model ProductAttributeValueOption {
  productAttributeValueId String @map("product_attribute_value_id") @db.VarChar(36)
  optionId                String @map("option_id") @db.VarChar(36)

  value  ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)
  option AttributeOption       @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productAttributeValueId, optionId])
  @@index([optionId])
  @@map("product_attribute_value_options")
}

// ============================================================================
// ATTRIBUTE VALUES (VARIANT)
// ============================================================================

model VariantAttributeValue {
  id          String @id @default(uuid()) @db.VarChar(36)
  variantId   String @map("variant_id") @db.VarChar(36)
  attributeId String @map("attribute_id") @db.VarChar(36)

  textValue    String?   @map("text_value") @db.Text
  numberValue  Decimal?  @map("number_value") @db.Decimal(18, 4)
  booleanValue Boolean?  @map("boolean_value")
  dateValue    DateTime? @map("date_value")
  optionId     String?   @map("option_id") @db.VarChar(36)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([variantId, attributeId])
  @@index([attributeId, optionId])
  @@index([deletedAt])
  @@map("variant_attribute_values")
}

/// Tag - nhãn tự do gắn vào sản phẩm
model Tag {
  id   String @id @default(uuid()) @db.VarChar(36)
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  products ProductTag[]

  @@map("tags")
}

/// Bảng trung gian - sản phẩm gắn nhiều tag
model ProductTag {
  productId String @map("product_id") @db.VarChar(36)
  tagId     String @map("tag_id") @db.VarChar(36)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ============================================================================
// CART
// ============================================================================

/// Giỏ hàng - mỗi user có 1 giỏ hàng
model Cart {
  id     String @id @default(uuid()) @db.VarChar(36)
  userId String @unique @map("user_id") @db.VarChar(36)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// Chi tiết giỏ hàng
model CartItem {
  id        String  @id @default(uuid()) @db.VarChar(36)
  cartId    String  @map("cart_id") @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  variantId String? @map("variant_id") @db.VarChar(36)
  quantity  Int

  // Relations
  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  /// Nếu variantId IS NULL, MySQL cho phép trùng (cartId, productId, NULL) → app phải enforce
  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

// ============================================================================
// ORDERS
// ============================================================================

/// Đơn hàng
model Order {
  id                String            @id @default(uuid()) @db.VarChar(36)
  userId            String            @map("user_id") @db.VarChar(36)
  subtotalPrice     Decimal           @default(0) @map("subtotal_price") @db.Decimal(10, 2)
  shippingFee       Decimal           @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  totalPrice        Decimal           @map("total_price") @db.Decimal(10, 2)
  status            OrderStatus       @default(PENDING)
  returnStatus      ReturnFlowStatus? @map("return_status")
  discountId        String?           @map("discount_id") @db.VarChar(36)
  discountAmount    Decimal?          @map("discount_amount") @db.Decimal(10, 2)
  itemsSubtotal     Decimal           @default(0) @map("items_subtotal") @db.Decimal(10, 2)
  productDiscount   Decimal           @default(0) @map("product_discount") @db.Decimal(10, 2)
  promotionDiscount Decimal           @default(0) @map("promotion_discount") @db.Decimal(10, 2)
  voucherDiscount   Decimal           @default(0) @map("voucher_discount") @db.Decimal(10, 2)
  grandTotal        Decimal           @default(0) @map("grand_total") @db.Decimal(10, 2)
  carrierName       String?           @map("carrier_name") @db.VarChar(120)
  trackingCode      String?           @map("tracking_code") @db.VarChar(120)
  deliveryNote      String?           @map("delivery_note") @db.VarChar(500)
  shippedAt         DateTime?         @map("shipped_at")
  deliveredAt       DateTime?         @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user               User                  @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payment            Payment?
  paymentTransaction PaymentTransaction?
  refundTransactions RefundTransaction[]
  cancelRequest      OrderCancelRequest?
  statusHistory      OrderStatusHistory[]
  shippingAddress    OrderShippingAddress?
  discount           Discount?             @relation(fields: [discountId], references: [id])
  discountUsage      DiscountUsage?
  promotionUsages    PromotionUsage[]
  shipment           OrderShipment?
  returnShipment     ReturnShipment?

  @@index([status])
  @@index([userId])
  @@map("orders")
}

/// Snapshot bất biến của địa chỉ giao hàng tại thời điểm tạo đơn.
/// sourceAddressId chỉ dùng để truy vết; không tạo FK để việc xóa địa chỉ hồ sơ
/// không thể làm thay đổi hoặc xóa dữ liệu lịch sử của đơn hàng.
model OrderShippingAddress {
  id              String   @id @default(uuid()) @db.VarChar(36)
  orderId         String   @unique @map("order_id") @db.VarChar(36)
  recipientName   String   @map("recipient_name") @db.VarChar(255)
  phone           String   @db.VarChar(20)
  addressLine     String   @map("address_line") @db.Text
  ward            String   @db.VarChar(100)
  district        String   @db.VarChar(100)
  city            String   @db.VarChar(100)
  sourceAddressId String?  @map("source_address_id") @db.VarChar(36)
  snapshotSource  String   @default("CHECKOUT") @map("snapshot_source") @db.VarChar(40)
  ghnProvinceId   Int?     @map("ghn_province_id")
  ghnDistrictId   Int?     @map("ghn_district_id")
  ghnWardCode     String?  @map("ghn_ward_code") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sourceAddressId])
  @@map("order_shipping_addresses")
}

model OrderShipment {
  id                String    @id @default(uuid()) @db.VarChar(36)
  orderId           String    @unique @map("order_id") @db.VarChar(36)
  provider          String    @db.VarChar(30)
  providerOrderCode String    @unique @map("provider_order_code") @db.VarChar(120)
  providerStatus    String?   @map("provider_status") @db.VarChar(80)
  serviceId         Int?      @map("service_id")
  serviceTypeId     Int?      @map("service_type_id")
  codAmount         Decimal?  @map("cod_amount") @db.Decimal(12, 2)
  externalFee       Decimal?  @map("external_fee") @db.Decimal(12, 2)
  rawCreatePayload  Json?     @map("raw_create_payload")
  rawCreateResponse Json?     @map("raw_create_response")
  rawLatestWebhook  Json?     @map("raw_latest_webhook")
  lastWebhookTime   DateTime? @map("last_webhook_time")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerStatus])
  @@map("order_shipments")
}

/// Vận đơn GHN độc lập để lấy hàng từ khách sau khi đơn giao đi đã hoàn tất.
model ReturnShipment {
  id                String    @id @default(uuid()) @db.VarChar(36)
  orderId           String    @unique @map("order_id") @db.VarChar(36)
  provider          String    @db.VarChar(30)
  providerOrderCode String    @unique @map("provider_order_code") @db.VarChar(120)
  providerStatus    String?   @map("provider_status") @db.VarChar(80)
  externalFee       Decimal?  @map("external_fee") @db.Decimal(12, 2)
  rawCreatePayload  Json?     @map("raw_create_payload")
  rawCreateResponse Json?     @map("raw_create_response")
  rawLatestStatus   Json?     @map("raw_latest_status")
  lastSyncedAt      DateTime? @map("last_synced_at")
  deliveredAt       DateTime? @map("delivered_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerStatus])
  @@map("return_shipments")
}

/// Chi tiết đơn hàng
model OrderItem {
  id                      String  @id @default(uuid()) @db.VarChar(36)
  orderId                 String  @map("order_id") @db.VarChar(36)
  productId               String  @map("product_id") @db.VarChar(36)
  variantId               String? @map("variant_id") @db.VarChar(36)
  quantity                Int
  price                   Decimal @db.Decimal(10, 2)
  productName             String  @default("") @map("product_name") @db.VarChar(255)
  productSlug             String? @map("product_slug") @db.VarChar(255)
  sku                     String  @default("") @db.VarChar(100)
  variantName             String? @map("variant_name") @db.VarChar(255)
  variantAttributes       Json?   @map("variant_attributes")
  imageUrl                String? @map("image_url") @db.VarChar(1000)
  originalUnitPrice       Decimal @default(0) @map("original_unit_price") @db.Decimal(10, 2)
  sellingUnitPrice        Decimal @default(0) @map("selling_unit_price") @db.Decimal(10, 2)
  lineSubtotal            Decimal @default(0) @map("line_subtotal") @db.Decimal(10, 2)
  lineDiscountAmount      Decimal @default(0) @map("line_discount_amount") @db.Decimal(10, 2)
  promotionDiscountAmount Decimal @default(0) @map("promotion_discount_amount") @db.Decimal(10, 2)
  voucherDiscountAmount   Decimal @default(0) @map("voucher_discount_amount") @db.Decimal(10, 2)
  lineTotal               Decimal @default(0) @map("line_total") @db.Decimal(10, 2)
  voucherEligible         Boolean @default(false) @map("voucher_eligible")
  promotionId             String? @map("promotion_id") @db.VarChar(36)
  promotionName           String? @map("promotion_name") @db.VarChar(255)
  promotionSnapshot       Json?   @map("promotion_snapshot")
  snapshotSource          String  @default("CHECKOUT") @map("snapshot_source") @db.VarChar(40)

  // Relations
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  promotion Promotion?      @relation(fields: [promotionId], references: [id])
  returns   Return[]
  reviews   Review[]        @relation("OrderItemReviews")

  @@unique([orderId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// ============================================================================
// PAYMENT (1 order = 1 payment chính)
// ============================================================================

/// Thanh toán - 1:1 với đơn hàng
model Payment {
  id            String        @id @default(uuid()) @db.VarChar(36)
  orderId       String        @unique @map("order_id") @db.VarChar(36)
  amount        Decimal       @db.Decimal(10, 2)
  method        String        @db.VarChar(50)
  transactionId String?       @unique @map("transaction_id") @db.VarChar(255)
  status        PaymentStatus @default(PENDING)

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

/// Giao dịch thanh toan online (idempotent qua trang thai PENDING)
model PaymentTransaction {
  id               String                   @id @default(uuid()) @db.VarChar(36)
  orderId          String                   @unique @map("order_id") @db.VarChar(36)
  orderCode        String                   @unique @map("order_code") @db.VarChar(64)
  amount           Decimal                  @db.Decimal(10, 2)
  status           PaymentTransactionStatus @default(PENDING)
  bankCode         String?                  @map("bank_code") @db.VarChar(20)
  gatewayReference String?                  @unique @map("vnp_transaction_no") @db.VarChar(64)
  gatewayCode      String?                  @map("vnp_response_code") @db.VarChar(10)
  gatewayStatus    String?                  @map("vnp_transaction_status") @db.VarChar(10)
  paidAt           DateTime?                @map("paid_at")
  rawPayload       Json?                    @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([orderCode])
  @@map("payment_transactions")
}

// ============================================================================
// PRICING HISTORY
// ============================================================================

/// Lịch sử thay đổi giá - phục vụ analytics và audit
model ProductPriceHistory {
  id        String  @id @default(uuid()) @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  variantId String? @map("variant_id") @db.VarChar(36)
  oldPrice  Decimal @map("old_price") @db.Decimal(10, 2)
  newPrice  Decimal @map("new_price") @db.Decimal(10, 2)
  changedBy String? @map("changed_by") @db.VarChar(36)

  changedAt DateTime @default(now()) @map("changed_at")

  // Relations
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@map("product_price_history")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

/// Mã giảm giá
model Discount {
  id                 String                @id @default(uuid()) @db.VarChar(36)
  code               String                @unique @db.VarChar(50)
  description        String?               @db.VarChar(500)
  type               DiscountType
  value              Decimal               @db.Decimal(10, 2)
  maxDiscount        Decimal?              @map("max_discount") @db.Decimal(10, 2)
  minOrderAmount     Decimal?              @map("min_order_amount") @db.Decimal(10, 2)
  maxUsage           Int?                  @map("max_usage")
  userUsageLimit     Int?                  @map("user_usage_limit")
  usedCount          Int                   @default(0) @map("used_count")
  startAt            DateTime              @map("start_at")
  endAt              DateTime              @map("end_at")
  isActive           Boolean               @default(true) @map("is_active")
  isBirthdayVoucher  Boolean               @default(false) @map("is_birthday_voucher")
  bannerImageUrl     String?               @map("banner_image_url") @db.VarChar(1000)
  scopeType          VoucherScopeType      @default(ALL_PRODUCTS) @map("scope_type")
  includeDescendants Boolean               @default(false) @map("include_descendants")
  minAmountBasis     VoucherMinAmountBasis @default(ELIGIBLE_SUBTOTAL) @map("min_amount_basis")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  usages             DiscountUsage[]
  birthdayGrants     BirthdayVoucherGrant[]
  orders             Order[]
  includedCategories DiscountIncludedCategory[]
  excludedCategories DiscountExcludedCategory[]
  includedProducts   DiscountIncludedProduct[]
  excludedProducts   DiscountExcludedProduct[]
  memberTiers        DiscountMemberTier[]

  @@index([isActive, startAt, endAt])
  @@map("discounts")
}

model Banner {
  id          String  @id @default(uuid()) @db.VarChar(36)
  title       String  @db.VarChar(255)
  subtitle    String? @db.VarChar(255)
  description String? @db.VarChar(500)
  imageUrl    String  @map("image_url") @db.VarChar(1000)
  isActive    Boolean @default(false) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("banners")
}

/// Lịch sử sử dụng mã giảm giá
model DiscountUsage {
  id         String @id @default(uuid()) @db.VarChar(36)
  discountId String @map("discount_id") @db.VarChar(36)
  userId     String @map("user_id") @db.VarChar(36)
  orderId    String @unique @map("order_id") @db.VarChar(36)
  usageYear  Int?   @map("usage_year")

  // Relations
  discount Discount @relation(fields: [discountId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([discountId, userId, usageYear])
  @@index([discountId])
  @@index([userId])
  @@map("discount_usages")
}

model BirthdayVoucherGrant {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  discountId     String    @map("discount_id") @db.VarChar(36)
  year           Int
  birthdayDate   DateTime  @map("birthday_date") @db.Date
  email          String    @db.VarChar(255)
  emailSentAt    DateTime? @map("email_sent_at")
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(120)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([discountId])
  @@index([birthdayDate])
  @@map("birthday_voucher_grants")
}

// ============================================================================
// INVENTORY LOG (Audit kho hàng)
// ============================================================================

/// Lịch sử nhập/xuất kho - theo dõi ở cấpđộ variant
model InventoryLog {
  id             String          @id @default(uuid()) @db.VarChar(36)
  variantId      String          @map("variant_id") @db.VarChar(36)
  action         InventoryAction
  quantity       Int
  referenceId    String?         @map("reference_id") @db.VarChar(36)
  beforeQuantity Int?            @map("before_quantity")
  afterQuantity  Int?            @map("after_quantity")
  referenceType  String?         @map("reference_type") @db.VarChar(50)
  actorId        String?         @map("actor_id") @db.VarChar(36)
  reason         String?         @db.VarChar(500)
  salesChannel   SalesChannel    @default(INTERNAL) @map("sales_channel")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@map("inventory_logs")
}

// ============================================================================
// RETURNS (Đúng cấp order_item)
// ============================================================================

/// Yêu cầu trả hàng - liên kết với từng order_item
model Return {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  orderItemId        String            @map("order_item_id") @db.VarChar(36)
  quantity           Int
  requestType        ReturnRequestType @default(RETURN_REFUND) @map("request_type")
  requestedVariantId String?           @map("requested_variant_id") @db.VarChar(36)
  reason             String?           @db.Text
  reasonCode         String?           @map("reason_code") @db.VarChar(50)
  evidenceImages     Json?             @map("evidence_images")
  bankAccountName    String?           @map("bank_account_name") @db.VarChar(255)
  bankAccountNumber  String?           @map("bank_account_number") @db.VarChar(50)
  bankName           String?           @map("bank_name") @db.VarChar(120)
  status             ReturnStatus      @default(RT_REQUESTED)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@index([reasonCode])
  @@index([requestType])
  @@index([requestedVariantId])
  @@map("returns")
}

// ============================================================================
// ORDER STATUS HISTORY
// ============================================================================

/// Lịch sử thay đổi trạng thái đơn hàng
model OrderStatusHistory {
  id        String       @id @default(uuid()) @db.VarChar(36)
  orderId   String       @map("order_id") @db.VarChar(36)
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")
  changedBy String?      @map("changed_by") @db.VarChar(36)
  reason    String?      @db.VarChar(500)

  changedAt DateTime @default(now()) @map("changed_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

/// Thông báo cho người dùng
model Notification {
  id      String  @id @default(uuid()) @db.VarChar(36)
  userId  String  @map("user_id") @db.VarChar(36)
  content String  @db.Text
  isRead  Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ============================================================================
// USER ACTIVITY LOG (Phân tích hành vi)
// ============================================================================

/// Lịch sử hoạt động người dùng - phục vụ phân tích AI
model UserActivityLog {
  id       String  @id @default(uuid()) @db.VarChar(36)
  userId   String? @map("user_id") @db.VarChar(36)
  action   String  @db.VarChar(255)
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_activity_logs")
}

model DiscountIncludedCategory {
  discountId String   @map("discount_id") @db.VarChar(36)
  categoryId String   @map("category_id") @db.VarChar(36)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
  @@map("discount_included_categories")
}

model DiscountExcludedCategory {
  discountId String   @map("discount_id") @db.VarChar(36)
  categoryId String   @map("category_id") @db.VarChar(36)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
  @@map("discount_excluded_categories")
}

model DiscountIncludedProduct {
  discountId String   @map("discount_id") @db.VarChar(36)
  productId  String   @map("product_id") @db.VarChar(36)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_included_products")
}

model DiscountExcludedProduct {
  discountId String   @map("discount_id") @db.VarChar(36)
  productId  String   @map("product_id") @db.VarChar(36)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_excluded_products")
}

model DiscountMemberTier {
  discountId String   @map("discount_id") @db.VarChar(36)
  tier       String   @db.VarChar(30)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, tier])
  @@map("discount_member_tiers")
}

model ChatSession {
  id                      String            @id @default(uuid()) @db.VarChar(36)
  userId                  String?           @map("user_id") @db.VarChar(36)
  status                  ChatSessionStatus @default(OPEN)
  channel                 String            @default("WEB_WIDGET") @db.VarChar(40)
  guestToken              String?           @map("guest_token") @db.VarChar(100)
  leadName                String?           @map("lead_name") @db.VarChar(120)
  leadPhone               String?           @map("lead_phone") @db.VarChar(20)
  leadEmail               String?           @map("lead_email") @db.VarChar(255)
  budgetMin               Decimal?          @map("budget_min") @db.Decimal(10, 2)
  budgetMax               Decimal?          @map("budget_max") @db.Decimal(10, 2)
  shopperProfile          Json?             @map("shopper_profile")
  lastIntent              String?           @map("last_intent") @db.VarChar(80)
  lastSummary             String?           @map("last_summary") @db.VarChar(500)
  lastSuggestedProductIds Json?             @map("last_suggested_product_ids")
  lastMessageAt           DateTime          @default(now()) @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, lastMessageAt])
