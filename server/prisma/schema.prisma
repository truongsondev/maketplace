model Promotion {
  id                   String                @id @default(uuid()) @db.VarChar(36)
  name                 String                @db.VarChar(255)
  slug                 String                @unique @db.VarChar(255)
  title                String                @db.VarChar(255)
  subtitle             String?               @db.VarChar(255)
  description          String?               @db.Text
  bannerImageUrl       String?               @map("banner_image_url") @db.VarChar(1000)
  mobileBannerImageUrl String?               @map("mobile_banner_image_url") @db.VarChar(1000)
  campaignType         PromotionCampaignType @default(CUSTOM) @map("campaign_type")
  type                 PromotionType
  status               PromotionStatus       @default(DRAFT)
  scopeType            PromotionScopeType    @default(ALL_PRODUCTS) @map("scope_type")
  includeDescendants   Boolean               @default(false) @map("include_descendants")
  value                Decimal               @db.Decimal(10, 2)
  maxDiscount          Decimal?              @map("max_discount") @db.Decimal(10, 2)
  priority             Int                   @default(0)
  displayPriority      Int                   @default(0) @map("display_priority")
  isFeatured           Boolean               @default(false) @map("is_featured")
  ctaLabel             String?               @map("cta_label") @db.VarChar(100)
  ctaUrl               String?               @map("cta_url") @db.VarChar(1000)
  memberTiers          Json?                 @map("member_tiers")
  usageLimit           Int?                  @map("usage_limit")
  usedCount            Int                   @default(0) @map("used_count")
  stackableWithVoucher Boolean               @default(true) @map("stackable_with_voucher")
  startAt              DateTime              @map("start_at")
  endAt                DateTime              @map("end_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  includedCategories PromotionIncludedCategory[]
  includedProducts   PromotionIncludedProduct[]
  orderItems         OrderItem[]
  usages             PromotionUsage[]

  @@index([status, startAt, endAt])
  @@index([priority])
  @@index([isFeatured, displayPriority])
  @@map("promotions")
}

