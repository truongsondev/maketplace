@startuml
' ERD 30 bảng chính - dùng class để PlantUML tô màu header ổn định.
' Tối ưu để render trong khoảng 2/3 trang A4 ngang, chữ rõ khi chèn vào Word.

left to right direction
hide circle
skinparam dpi 260
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 4
skinparam nodesep 8
skinparam ranksep 10
skinparam pageMargin 2
skinparam classAttributeIconSize 0
page 1x1
scale max 1280*520

skinparam defaultFontName Arial
skinparam defaultFontSize 19
skinparam classFontName Arial
skinparam classFontSize 20
skinparam classAttributeFontSize 18

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #6EA8D7
  BorderThickness 1.5
  HeaderBackgroundColor #BFE3FF
  FontColor #111827
  ArrowColor #1F2937
}

skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #BFE3FF
skinparam classBorderColor #6EA8D7
skinparam classFontColor #111827
skinparam classAttributeFontColor #111827

class "users" as users {
  * id : String
  email : String
  phone : String
  password_hash : String
  status : UserStatus
}

class "refresh_tokens" as refresh_tokens {
  * id : String
  user_id : String
  token : String
  expires_at : DateTime
  revoked : Boolean
}

class "roles" as roles {
  * id : Int
  code : String
  name : String
}

class "user_roles" as user_roles {
  * user_id : String
  * role_id : Int
}

class "user_addresses" as user_addresses {
  * id : String
  user_id : String
  recipient : String
  phone : String
  is_default : Boolean
}

class "products" as products {
  * id : String
  product_type_id : String
  name : String
  base_price : Decimal
  status : ProductStatus
  is_deleted : Boolean
}

class "product_variants" as product_variants {
  * id : String
  product_id : String
  sku : String
  price : Decimal
  stock_available : Int
  stock_reserved : Int
}

class "product_images" as product_images {
  * id : String
  product_id : String
  variant_id : String
  url : String
  is_primary : Boolean
}

class "categories" as categories {
  * id : String
  parent_id : String
  name : String
  slug : String
}

class "product_categories" as product_categories {
  * product_id : String
  * category_id : String
  is_primary : Boolean
}

class "product_types" as product_types {
  * id : String
  code : String
  name : String
}

class "attribute_definitions" as attribute_definitions {
  * id : String
  code : String
  name : String
  scope : AttributeScope
  data_type : AttributeDataType
}

class "attribute_options" as attribute_options {
  * id : String
  attribute_id : String
  value : String
  label : String
}

class "product_type_attributes" as product_type_attributes {
  * product_type_id : String
  * attribute_id : String
  is_required : Boolean
  is_variant_axis : Boolean
}

class "product_attribute_values" as product_attribute_values {
  * id : String
  product_id : String
  attribute_id : String
  text_value : String
  option_id : String
}

class "product_attribute_value_options" as product_attribute_value_options {
  * product_attribute_value_id : String
  * option_id : String
}

class "variant_attribute_values" as variant_attribute_values {
  * id : String
  variant_id : String
  attribute_id : String
  text_value : String
  option_id : String
}

class "carts" as carts {
  * id : String
  user_id : String
  created_at : DateTime
}

class "cart_items" as cart_items {
  * id : String
  cart_id : String
  product_id : String
  variant_id : String
  quantity : Int
}

class "orders" as orders {
  * id : String
  user_id : String
  discount_id : String
  total_price : Decimal
  status : OrderStatus
}

class "order_items" as order_items {
  * id : String
  order_id : String
  product_id : String
  variant_id : String
  quantity : Int
  price : Decimal
}

class "payments" as payments {
  * id : String
  order_id : String
  amount : Decimal
  method : String
  status : PaymentStatus
}

class "payment_transactions" as payment_transactions {
  * id : String
  order_id : String
  order_code : String
  amount : Decimal
  status : PaymentTransactionStatus
}

class "order_status_history" as order_status_history {
  * id : String
  order_id : String
  old_status : OrderStatus
  new_status : OrderStatus
  changed_at : DateTime
}

class "discounts" as discounts {
  * id : String
  code : String
  type : DiscountType
  value : Decimal
  start_at : DateTime
  end_at : DateTime
}

class "discount_usages" as discount_usages {
  * id : String
  discount_id : String
  user_id : String
  order_id : String
}

class "inventory_logs" as inventory_logs {
  * id : String
  variant_id : String
  action : InventoryAction
  quantity : Int
  reference_id : String
}

class "returns" as returns {
  * id : String
  order_item_id : String
  quantity : Int
  reason_code : String
  status : ReturnStatus
}

class "refund_transactions" as refund_transactions {
  * id : String
  order_id : String
  type : RefundType
  amount : Decimal
  status : RefundStatus
}

class "order_cancel_requests" as order_cancel_requests {
  * id : String
  order_id : String
  reason_code : CancelReason
  status : CancelRequestStatus
  requested_by_user_id : String
}

' ===== Quan hệ người dùng =====
users ||--o{ refresh_tokens
users ||--o{ user_addresses
users ||--o{ user_roles
roles ||--o{ user_roles

' ===== Quan hệ catalog =====
product_types ||--o{ products
products ||--o{ product_variants
products ||--o{ product_images
product_variants ||--o{ product_images
products ||--o{ product_categories
categories ||--o{ product_categories
categories ||--o{ categories

' ===== Quan hệ thuộc tính sản phẩm =====
product_types ||--o{ product_type_attributes
attribute_definitions ||--o{ product_type_attributes
attribute_definitions ||--o{ attribute_options
products ||--o{ product_attribute_values
attribute_definitions ||--o{ product_attribute_values
attribute_options ||--o{ product_attribute_values
product_attribute_values ||--o{ product_attribute_value_options
attribute_options ||--o{ product_attribute_value_options
product_variants ||--o{ variant_attribute_values
attribute_definitions ||--o{ variant_attribute_values
attribute_options ||--o{ variant_attribute_values

' ===== Quan hệ giỏ hàng =====
users ||--o| carts
carts ||--o{ cart_items
products ||--o{ cart_items
product_variants ||--o{ cart_items

' ===== Quan hệ đơn hàng và thanh toán =====
users ||--o{ orders
orders ||--|{ order_items
products ||--o{ order_items
product_variants ||--o{ order_items
orders ||--o{ payments
orders ||--o{ payment_transactions
orders ||--o{ order_status_history

' ===== Quan hệ khuyến mãi và hậu mãi =====
discounts ||--o{ orders
discounts ||--o{ discount_usages
orders ||--o| discount_usages
product_variants ||--o{ inventory_logs
order_items ||--o{ returns
orders ||--o{ refund_transactions
orders ||--o| order_cancel_requests
@enduml
