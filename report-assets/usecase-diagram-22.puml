@startuml
left to right direction

skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

title Lược đồ Use Case hệ thống thương mại thời trang AI

actor "Guest" as Guest
actor "User" as User
actor "Admin" as Admin
actor "System" as System
actor "PayOS" as PayOS

rectangle "Hệ thống thương mại thời trang AI" {
  package "Người dùng" {
    usecase "UC-01\nĐăng nhập" as UC01
    usecase "UC-02\nĐăng ký tài khoản" as UC02
    usecase "UC-03\nQuên mật khẩu" as UC03
    usecase "UC-04\nTìm kiếm và lọc\nsản phẩm" as UC04
    usecase "UC-05\nThêm sản phẩm\nvào giỏ hàng" as UC05
    usecase "UC-06\nĐặt hàng và\nthanh toán" as UC06
    usecase "UC-07\nÁp dụng voucher" as UC07
    usecase "UC-08\nChatbot tư vấn" as UC08
    usecase "UC-09\nGợi ý sản phẩm\nbằng AI" as UC09
    usecase "UC-10\nYêu thích sản phẩm" as UC10
    usecase "UC-11\nHủy đơn hàng\nbởi người dùng" as UC11
    usecase "UC-12\nĐánh giá sản phẩm" as UC12
    usecase "UC-13\nYêu cầu trả hàng/\nhoàn tiền" as UC13
  }

  package "Quản trị" {
    usecase "UC-14\nTạo sản phẩm mới" as UC14
    usecase "UC-15\nChỉnh sửa sản phẩm" as UC15
    usecase "UC-16\nXóa/Tạm ngưng\nsản phẩm" as UC16
    usecase "UC-17\nQuản lý voucher" as UC17
    usecase "UC-18\nQuản lý người dùng" as UC18
    usecase "UC-19\nQuản lý banner" as UC19
    usecase "UC-20\nQuản lý tồn kho" as UC20
    usecase "UC-21\nExport sản phẩm\nra file CSV" as UC21
  }

  package "Nền hệ thống" {
    usecase "UC-22\nWorker đối soát PayOS" as UC22
  }
}

Guest -- UC01
Guest -- UC02
Guest -- UC03
Guest -- UC04
Guest -- UC08
Guest -- UC09

User -- UC01
User -- UC04
User -- UC05
User -- UC06
User -- UC07
User -- UC08
User -- UC09
User -- UC10
User -- UC11
User -- UC12
User -- UC13

Admin -- UC01
Admin -- UC14
Admin -- UC15
Admin -- UC16
Admin -- UC17
Admin -- UC18
Admin -- UC19
Admin -- UC20
Admin -- UC21

System -- UC09
System -- UC22
PayOS -- UC06
PayOS -- UC22

UC15 ..> UC20 : <<extend>>
UC16 ..> UC15 : <<extend>>
UC07 ..> UC06 : <<extend>>
UC09 ..> UC04 : <<extend>>
UC21 ..> UC04 : <<include>>
UC22 ..> UC06 : <<extend>>

@enduml
