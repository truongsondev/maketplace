@startuml
left to right direction

skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

title Lược đồ Use Case tổng quát hệ thống thương mại thời trang AI

actor "Người truy cập" as Visitor
actor "Guest" as Guest
actor "User" as User
actor "Admin" as Admin
actor "Google" as Google <<external>>
actor "Email Service" as EmailService <<external>>
actor "PayOS" as PayOS <<external>>
actor "AI Service" as AIService <<external>>
actor "System Scheduler" as Scheduler <<system>>

Guest --|> Visitor
User --|> Visitor
Admin --|> User

rectangle "Hệ thống thương mại thời trang AI" {
  package "Xác thực tài khoản" {
    usecase "UC-01\nĐăng nhập" as UC01
    usecase "UC-02\nĐăng ký tài khoản" as UC02
    usecase "UC-03\nQuên mật khẩu" as UC03
  }

  package "Tra cứu và tương tác sản phẩm" {
    usecase "UC-04\nTìm kiếm sản phẩm" as UC04
    usecase "UC-09\nTư vấn qua chatbot" as UC09
    usecase "UC-10\nXem gợi ý sản phẩm\ncá nhân hóa" as UC10
    usecase "UC-11\nThêm sản phẩm vào\ndanh sách yêu thích" as UC11
    usecase "UC-14\nĐánh giá sản phẩm" as UC14
  }

  package "Giỏ hàng và đơn hàng" {
    usecase "UC-05\nThêm sản phẩm\nvào giỏ hàng" as UC05
    usecase "UC-06\nXóa sản phẩm\nkhỏi giỏ hàng" as UC06
    usecase "UC-07\nĐặt hàng và\nthanh toán đơn hàng" as UC07
    usecase "UC-08\nÁp dụng voucher\ncho đơn hàng" as UC08
    usecase "UC-12\nXem chi tiết\nđơn hàng" as UC12
    usecase "UC-13\nHủy đơn hàng" as UC13
    usecase "UC-15\nGửi yêu cầu trả hàng/\nhoàn tiền" as UC15
  }

  package "Quản trị vận hành" {
    usecase "UC-16\nQuản lý sản phẩm" as UC16
    usecase "UC-17\nQuản lý voucher" as UC17
    usecase "UC-18\nQuản lý người dùng" as UC18
    usecase "UC-19\nQuản lý banner" as UC19
    usecase "UC-20\nQuản lý đơn hàng" as UC20
    usecase "UC-21\nQuản lý trả hàng và\ngiao dịch hoàn tiền" as UC21
    usecase "UC-22\nXuất danh sách sản phẩm\nra file CSV" as UC22
    usecase "UC-23\nWorker đối soát PayOS" as UC23
    usecase "UC-24\nXem dashboard/\ntổng quan" as UC24
  }
}

' Actor associations follow Bảng 3.2. Inherited actors can perform parent use cases.
User -- UC01
Google -- UC01

Guest -- UC02
EmailService -- UC02

User -- UC03
EmailService -- UC03

Visitor -- UC04

User -- UC05
User -- UC06
User -- UC07
PayOS -- UC07
User -- UC08

Visitor -- UC09
AIService -- UC09

User -- UC10
AIService -- UC10

User -- UC11
User -- UC12
User -- UC13
Admin -- UC13
User -- UC14
User -- UC15
Admin -- UC15

Admin -- UC16
Admin -- UC17
Admin -- UC18
Admin -- UC19
Admin -- UC20
Admin -- UC21
Admin -- UC22
Admin -- UC23
Admin -- UC24
Scheduler -- UC23
PayOS -- UC23

' Include / extend relationships inferred from the main use-case descriptions.
UC09 ..> UC04 : <<include>>
UC10 ..> UC04 : <<extend>>

UC07 ..> UC05 : <<include>>
UC08 ..> UC07 : <<extend>>
UC13 ..> UC12 : <<extend>>
UC14 ..> UC12 : <<extend>>
UC15 ..> UC12 : <<extend>>

UC21 ..> UC20 : <<extend>>
UC22 ..> UC16 : <<extend>>
UC23 ..> UC07 : <<extend>>
UC24 ..> UC16 : <<include>>
UC24 ..> UC20 : <<include>>
UC24 ..> UC18 : <<include>>

@enduml
